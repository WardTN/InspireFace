<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginVertical="5dp"
    android:layout_marginHorizontal="10dp"
    app:cardCornerRadius="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_bg"
        android:layout_width="match_parent"
        android:background="@color/color_1"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_feature_title"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:text="@string/face_analy"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginLeft="@dimen/feature_item_margin"
            android:layout_marginBottom="@dimen/feature_item_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:src="@drawable/endo_history_left_2"
            android:layout_width="40dp"
            android:layout_margin="@dimen/feature_item_margin"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_height="20dp"/>

        <ImageView
            android:id="@+id/iv_feature"
            app:layout_constraintTop_toTopOf="parent"
            android:src="@drawable/icon_take_pic"
            android:layout_width="40dp"
            android:layout_margin="@dimen/feature_item_margin"
            app:layout_constraintLeft_toLeftOf="parent"
            android:layout_height="40dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>