<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/face_analy_color"
    app:cardCornerRadius="10dp"
    android:layout_height="200dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <ImageView
            android:src="@drawable/kun"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            tools:layout_editor_absoluteX="5dp"
            tools:layout_editor_absoluteY="5dp" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/index_item_time"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/healthy_item_margin"
            android:text="张三"
            android:textSize="11dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_record"
            android:paddingHorizontal="5dp"
            android:paddingVertical="3dp"
            android:background="@drawable/index_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/healthy_item_margin"
            android:text="2024-01-01"
            android:textSize="11dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent" />

        <TextView
            android:id="@+id/iv_edit"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:layout_margin="@dimen/healthy_item_margin"
            android:background="@drawable/bg_edit"
            android:gravity="center"
            android:text="Edit"
            app:layout_constraintRight_toRightOf="parent"
            android:textColor="@color/white"
            android:textSize="11dp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/iv_delete"
            android:layout_width="50dp"
            android:layout_height="20dp"
            android:layout_margin="@dimen/feature_item_margin"
            android:background="@drawable/bg_edit"
            android:gravity="center"
            android:text="Delete"
            android:textColor="@color/white"
            android:textSize="11dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

