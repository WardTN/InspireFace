<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">




        <ImageView
            android:id="@+id/iv_face1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/kun"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_select_face1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_face2"
            android:layout_margin="10dp" />

        <ImageView
            android:id="@+id/iv_face2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/kun"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btn_select_face2"
            app:layout_constraintStart_toEndOf="@+id/iv_face1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:layout_margin="10dp" />

        <Button
            android:id="@+id/btn_select_face1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="选择人脸1"
            app:layout_constraintTop_toBottomOf="@+id/iv_face1"
            app:layout_constraintStart_toStartOf="@+id/iv_face1"
            app:layout_constraintEnd_toEndOf="@+id/iv_face1"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btn_select_face2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="选择人脸2"
            app:layout_constraintTop_toBottomOf="@+id/iv_face2"
            app:layout_constraintStart_toStartOf="@+id/iv_face2"
            app:layout_constraintEnd_toEndOf="@+id/iv_face2"
            android:layout_marginTop="16dp" />


        <Button
            android:id="@+id/btn_compare"
            android:text="开始比对"
            app:layout_constraintTop_toBottomOf="@+id/btn_select_face1"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="50dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
